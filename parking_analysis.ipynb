import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

np.random.seed(42)
dates = pd.date_range(start="2026-09-01", end="2026-09-21", freq="H")
zones = ['Zone A (Retail)', 'Zone B (Office)', 'Zone C (Residential)']

data = []
for z in zones:
    for d in dates:
        h = d.hour
        w = d.dayofweek
        if 'Retail' in z:
            b = 75 if w >= 5 else 45 if (10 <= h <= 21) else 10
        elif 'Office' in z:
            b = 85 if (w < 5 and 8 <= h <= 18) else 8
        else:
            b = 85 if (h <= 7 or h >= 19) else (65 if w >= 5 else 30)
        
        occ = max(0, min(100, int(b + np.random.normal(0, 6))))
        cap = 200 if 'Office' in z else (150 if 'Retail' in z else 100)
        data.append([d, z, cap, int((occ / 100.0) * cap), occ])

df = pd.DataFrame(data, columns=['Timestamp', 'Zone', 'Capacity', 'Occupied', 'Occupancy_Rate'])
df['Hour'] = df['Timestamp'].dt.hour
df['Day'] = df['Timestamp'].dt.day_name()
df['Is_Weekend'] = df['Timestamp'].dt.dayofweek.isin([5, 6])

print(df.head())
print(df.groupby('Zone')['Occupancy_Rate'].mean())

plt.figure(figsize=(10, 5))
sns.lineplot(data=df, x='Hour', y='Occupancy_Rate', hue='Zone')
plt.title('Parking Occupancy by Hour')
plt.xlabel('Hour of Day')
plt.ylabel('Occupancy Rate (%)')
plt.grid(True)
plt.show()
